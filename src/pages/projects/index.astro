---
import { url } from "../../lib/url";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Contact from "../../components/Contact.astro";
import { getEntry } from "astro:content";
import ProjectDetail from "../../components/ProjectDetail.astro";
import RovSpec from "../../components/rov/RovSpec.astro";
import RovDive from "../../components/rov/RovDive.astro";
import SalesPipeline from "../../components/islands/SalesPipeline";
import "../../styles/journey.css";
import "../../styles/deep.css";

// The projects, in the "Bioluminescent Deep" style. A picker at the top
// shows one project at a time and sets the whole page's mood: each choice is
// a radio button, and deep.css restyles the page from :root:has(...:checked),
// so it works without JS. src/scripts/deep.ts remembers the choice (?vibe=
// and localStorage), so the homepage's doors can open a given project.
const vibes = [
	{ id: "rov", label: "ROV", text: "An underwater vehicle, from the controller down to six thrusters, taken to 30 m." },
	{ id: "web", label: "Websites & Enterprise", text: "Company websites, Odoo ERP and CRM, and the sales side behind them." },
	{ id: "school", label: "Gamified School", text: "Git, Docker, PostgreSQL and system design as quests, for my college students." },
	{ id: "drill", label: "Drilling Simulation", text: "A well-drilling simulator with ESP32 boards as the rig's real control panels." },
	{ id: "iot", label: "IoT builds", text: "A backup-power camera, a sous vide controller and a smart AC remote." },
];

// Each project's write-up, shown under its panel while it is picked
const entry = async (id: string) => (await getEntry("projects", id))!;
const school = await entry("gamified-school");
const drill = await entry("drilling-simulation");
const web = await entry("web-enterprise");
const iot = await Promise.all(["backup-power-camera", "sous-vide", "ac-remote"].map(entry));

const quest = ["git commit -m \"first\"", "docker run -d postgres", "CREATE TABLE heroes (...);", "SELECT * FROM heroes;"];
const term: [string, boolean][] = [
	["$ iot --list", true],
	["  esp32-cam   sous-vide   ac-remote", false],
	["$ esp32-cam --status", true],
	["  power ....... battery backup", false],
	["$ sousvide --status", true],
	["  heater ...... holding temperature", false],
	["$ ac-remote --send power", true],
	["  ir .......... sent", false],
];

// Decorative particles: position, size, speed and delay per particle.
const particles = Array.from({ length: 18 }, (_, i) => ({
	x: (i * 37 + 11) % 100,
	y: (i * 53 + 7) % 100,
	s: 3 + ((i * 7) % 6),
	d: 14 + ((i * 11) % 16),
	l: -((i * 13) % 20),
}));
---

<BaseLayout
	title="Projects · Mohammad Yarahmadi, embedded software engineer"
	description="Five projects, each in its own world: an underwater ROV, a gamified programming school, a drilling simulator, ESP32 builds, and websites and Odoo ERP for businesses."
	bodyClass="deep"
>
	<div class="d-sea" aria-hidden="true">
		{vibes.map((v) => <div class={`d-sea__layer d-sea__layer--${v.id}`}></div>)}
		<img class="d-sea__photo" src={url("/media/rov-deep.jpg")} alt="" width="640" height="360" />
		<div class="d-sea__rays"></div>
		{
			particles.map((p) => (
				<span
					class="d-particle"
					style={`--x:${p.x}%;--y:${p.y}%;--s:${p.s}px;--dur:${p.d}s;--delay:${p.l}s`}
				/>
			))
		}
	</div>

	<span id="top" aria-hidden="true"></span>
	<section class="d-hero" id="projects" aria-labelledby="d-pick-legend">
		<fieldset class="d-pick">
			<legend id="d-pick-legend">Pick a subject</legend>
			<div class="d-pick__row">
				{
					vibes.map((v, i) => (
						<label class="d-chip">
							<input type="radio" name="vibe" value={v.id} id={`vibe-${v.id}`} checked={i === 0} />
							<span class="d-chip__dot" aria-hidden="true" />
							<span>{v.label}</span>
						</label>
					))
				}
			</div>
		</fieldset>

		<div class="d-panel d-panel--rov">
			<div class="d-copy">
				<h1><strong>ROV</strong></h1>
				<p class="d-lede">
					A tethered underwater vehicle, driven with a controller. I built the chain from the
					laptop down to six thrusters, and the network that brings the camera back up.
				</p>
			</div>
			<RovSpec />
		</div>

		<div class="d-panel d-panel--school">
			<div class="d-copy">
				<h1><strong>Gamified School</strong></h1>
				<p class="d-lede">
					A learning platform I built with AI for the college students I was teaching. Git,
					Docker, PostgreSQL and system design become quests, with Docker and PostgreSQL
					simulated inside the app.
				</p>
			</div>
			<div class="d-visual d-card-quest" aria-hidden="true">
				<div class="d-card-quest__head"><span>QUEST 04</span><span>LVL 4</span></div>
				<p class="d-card-quest__title">Ship your first database</p>
				<ul>{quest.map((q) => <li>{q}</li>)}</ul>
				<div class="d-xp"><i></i></div>
			</div>
		</div>

		<div class="d-panel d-panel--drill">
			<div class="d-copy">
				<h1><strong>Drilling Simulation</strong></h1>
				<p class="d-lede">
					A physical well-drilling simulator built for a company. ESP32 boards act as the rig's
					control panels, so trainees work with real panels and controls, not just a screen.
				</p>
			</div>
			<div class="d-visual d-card-rig" aria-hidden="true">
				<svg viewBox="0 0 320 260" fill="none" stroke="currentColor" stroke-width="1.5">
					<path d="M110 220 L160 30 L210 220"></path>
					<path d="M122 175 H198 M134 130 H186 M146 85 H174"></path>
					<path d="M60 220 H260"></path>
					<path class="d-rig__pipe" d="M160 30 V250" stroke-dasharray="4 4"></path>
					<path d="M152 240 L160 256 L168 240 Z" fill="currentColor"></path>
				</svg>
				<ul class="d-leds">
					<li>ESP32 panel A <b>Online</b></li>
					<li>ESP32 panel B <b>Online</b></li>
					<li>ESP32 panel C <b>Online</b></li>
				</ul>
			</div>
		</div>

		<div class="d-panel d-panel--iot">
			<div class="d-copy">
				<h1><strong>IoT</strong> builds</h1>
				<p class="d-lede">
					A camera that keeps recording through a power cut, a sous vide controller and a smart
					AC remote, all on ESP32. Two of them have live demos.
				</p>
				<div class="d-actions d-actions--stack">
					<a class="btn btn--primary" href="#detail-backup-power-camera">Camera + live diagram ↓</a>
					<a class="btn" href="#detail-sous-vide">Sous vide + demo ↓</a>
					<a class="btn" href="#detail-ac-remote">AC remote ↓</a>
				</div>
			</div>
			<div class="d-visual d-card-term" aria-hidden="true">
				<div class="d-card-term__bar"><i></i><i></i><i></i></div>
				<pre>{term.map(([t, cmd]) => <span class={cmd ? "cmd" : ""}>{t + "\n"}</span>)}<span class="cmd">$ <span class="blink">_</span></span></pre>
			</div>
		</div>

		<div class="d-panel d-panel--web">
			<div class="d-copy">
				<h1><strong>Websites &amp; Enterprise</strong></h1>
				<p class="d-lede">
					Company websites, currently Dealfdi, plus Odoo ERP and CRM. Before that I sold the
					websites our team built, so I know the client's side of the table.
				</p>
			</div>
			{/* a small CRM with made-up deals, in the style of Odoo */}
			<div class="d-visual d-card-pipe">
				<SalesPipeline client:visible />
			</div>
		</div>
	</section>

	{/* The write-ups, one block per project; deep.css shows the picked one's. */}
	<div class="d-details d-details--school"><ProjectDetail project={school} title="About the project" repeatsLede /></div>
	<div class="d-details d-details--drill"><ProjectDetail project={drill} title="About the project" repeatsLede /></div>
	<div class="d-details d-details--iot">{iot.map((p) => <ProjectDetail project={p} />)}</div>
	<div class="d-details d-details--web"><ProjectDetail project={web} title="About the project" repeatsLede /></div>

	{/* The ROV's full dive, shown while the ROV is picked (deep.css hides it otherwise). */}
	<RovDive />

	{/* Points on to the project after the picked one; deep.css shows only that card. */}
	<section class="d-next" id="next" aria-labelledby="next-title">
		<h2 id="next-title">Next project</h2>
		{
			vibes.map((v) => (
				<a class={`d-card d-card--${v.id}`} href={`?vibe=${v.id}#projects`} data-vibe={v.id}>
					<h3>{v.label}</h3>
					<p>{v.text}</p>
					<span class="d-card__link" aria-hidden="true">Open {v.label} →</span>
				</a>
			))
		}
	</section>

	<div class="j-plain d-plain">
		<Contact />
	</div>

	<script>
		import "../../scripts/deep.ts";
	</script>
</BaseLayout>
