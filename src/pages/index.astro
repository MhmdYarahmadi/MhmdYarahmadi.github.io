---
import BaseLayout from "../layouts/BaseLayout.astro";
import Backdrop from "../components/journey/Backdrop.astro";
import Rail from "../components/journey/Rail.astro";
import SceneIntro from "../components/journey/SceneIntro.astro";
import SceneRov from "../components/journey/SceneRov.astro";
import SceneSchool from "../components/journey/SceneSchool.astro";
import SceneDrill from "../components/journey/SceneDrill.astro";
import SceneIot from "../components/journey/SceneIot.astro";
import SceneWeb from "../components/journey/SceneWeb.astro";
import Stack from "../components/home/Stack.astro";
import AboutMe from "../components/home/AboutMe.astro";
import Contact from "../components/Contact.astro";
import Notes from "../components/journey/Notes.astro";
import RovDive from "../components/rov/RovDive.astro";
import { getEntry } from "astro:content";
import "../styles/journey.css";
import "../styles/home.css";

const entry = async (id: string) => (await getEntry("projects", id))!;
const school = await entry("gamified-school");
const drill = await entry("drilling-simulation");
const web = await entry("web-enterprise");
const iot = await Promise.all(["backup-power-camera", "sous-vide", "ac-remote"].map(entry));
---

{/* The homepage, and the site's only page: a scroll journey. Each project is a full-screen world
    with its own look (src/styles/journey.css), driven by
    src/scripts/journey.ts. The skills stack, about and contact
    (src/components/home/) follow in the plain
    site style. Each world is followed by its write-ups (Notes.astro); the ROV is followed
    by its full dive (RovDive.astro). */}
<BaseLayout
	title="Mohammad Yarahmadi · Embedded software engineer"
	description="Embedded software, IoT and web: an underwater ROV, a gamified programming school, a drilling simulator, ESP32 builds, and websites and Odoo ERP for businesses."
>
	<div class="journey">
		{/* first Tab stop: jumps past the 9 rail links to the hero */}
		<a class="skip-link" href="#top">Skip to content</a>
		<Backdrop />
		<Rail />
		<SceneIntro />
		<SceneRov />
		<RovDive />
		<SceneSchool />
		<Notes scene="school" world="school" chapter="02 · Gamified School · Notes" label="About the Gamified School" projects={[school]} title="About the Gamified School" repeatsLede />
		<SceneDrill />
		<Notes scene="drilling" world="drill" chapter="03 · Drilling sim · Notes" label="About the Drilling Simulation" projects={[drill]} title="About the Drilling Simulation" repeatsLede />
		<SceneIot />
		<Notes scene="iot" world="iot" chapter="04 · IoT builds · Notes" label="About the IoT builds" projects={iot} />
		<SceneWeb />
		<Notes scene="web" world="web" chapter="05 · Websites & Enterprise · Notes" label="About Websites and Enterprise" projects={[web]} title="About Websites and Enterprise" repeatsLede>
			<p>
				<a class="btn" href="https://dealfdi.com">
					See Dealfdi live
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
				</a>
			</p>
		</Notes>
		<div class="j-plain">
			<Stack journey />
			<AboutMe journey />
			<Contact />
		</div>
	</div>
	<script>
		import "../scripts/journey.ts";
	</script>
</BaseLayout>
