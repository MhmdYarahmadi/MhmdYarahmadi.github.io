---
/** "From the pin to the browser": each layer of a connected device, and
    the projects that use it. Used by the homepage,
    which names the projects' sections its own way. */
interface Props {
	journey?: boolean;
}
const { journey = false } = Astro.props;

const href = journey
	? { rov: "#rov", drill: "#drilling", school: "#school", iot: "#iot", web: "#web" }
	: { rov: "#rov", drill: "#drilling-simulation", school: "#gamified-school", iot: "#builds", web: "#client-work" };

const stack = [
	{
		layer: "Hardware & sensors",
		what: "Leak sensor, control panels, battery backup, infrared, heaters",
		used: [["ROV", href.rov], ["Drilling Simulation", href.drill], ["Camera", href.iot]],
	},
	{
		layer: "Firmware",
		what: "ESP32 and ESP32-CAM: PWM, panel I/O, closed-loop control",
		used: [["ROV", href.rov], ["Drilling Simulation", href.drill], ["Sous vide", href.iot]],
	},
	{
		layer: "Edge Linux",
		what: "Raspberry Pi 5 and Jetson Nano: decoding commands, serial links to the microcontrollers",
		used: [["ROV", href.rov], ["Drilling Simulation", href.drill]],
	},
	{
		layer: "Networking & video",
		what: "UDP control links, IP networks over a tether, RTSP camera video, a Python/Qt control app, cellular uplinks",
		used: [["ROV", href.rov], ["Camera", href.iot]],
	},
	{
		layer: "Web & business software",
		what: "Odoo ERP and CRM with custom modules that bring IoT data in, company websites, 3D in the browser with Three.js",
		used: [["Websites & Enterprise", href.web], ["Gamified School", href.school]],
	},
];
---

<section
	class="h-section h-section--alt"
	id="skills"
	data-world={journey ? "plain" : undefined}
	data-chapter={journey ? "06 · What I work with" : undefined}
	aria-labelledby="skills-title"
>
	<div class="h-wrap">
		<header class="h-head">
			<p class="eyebrow">What I work with</p>
			<h2 id="skills-title">From the pin to the browser</h2>
			<p>Every layer of a connected device, and where each one shows up in the work.</p>
		</header>
		<ol class="h-stack">
			{
				stack.map((s, i) => (
					<li>
						<span class="h-stack__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
						<h3>{s.layer}</h3>
						<p>{s.what}</p>
						<ul class="h-stack__used" aria-label="Used in">
							{s.used.map(([label, to]) => <li><a href={to}>{label}</a></li>)}
						</ul>
					</li>
				))
			}
		</ol>
		<p class="h-learning">
			<span class="h-dot" aria-hidden="true"></span> Now building: Engram, a small on-device language model with a knowledge module, so new knowledge can be added right on a phone.
		</p>
	</div>
</section>
