---
import RovSpec from "../rov/RovSpec.astro";
// The ROV's world: heading, lede and spec sheet. The full dive
// (RovDive.astro) follows it.
---

<section class="j-scene w-rov" id="rov" data-world="rov" data-chapter="01 · ROV · Ocean descent" aria-label="ROV project">
	<div class="j-stick">
		<div class="j-copy">
			<p class="j-tag rv">01 · Flagship hardware</p>
			<h2 class="rv" style="--d:60ms">ROV</h2>
			<p class="j-lede rv" style="--d:120ms">
				A tethered underwater vehicle, driven to 30 m. I built the control chain from a
				Python/Qt app on the laptop down to six PID-controlled thrusters, and the network that
				brings the live camera back up.
			</p>
		</div>
		<div class="rov-spec rv" style="--d:200ms">
			<RovSpec />
		</div>
	</div>
</section>
