---
const panels = ["A", "B", "C"];
// The rig follows scroll until the visitor touches the demo console, then
// src/scripts/drill.ts drives it: weight on bit × rotary speed, slowed by
// harder strata, with the mud pump keeping the bit cool.
---

<section class="j-scene w-drill" id="drilling" data-world="drill" data-chapter="03 · Drilling sim · Blueprint" aria-label="Drilling Simulation project">
	<div class="j-stick">
		<div class="j-copy">
			<p class="j-tag rv">03 · Industrial · Oil &amp; gas</p>
			<h2 class="rv" style="--d:60ms"><span>Drilling</span><span>Simulation</span></h2>
			<p class="j-lede rv" style="--d:140ms">
				A physical well-drilling simulator for training, built for the National Iranian
				Drilling Company. ESP32 boards act as the rig's real control panels, and a Jetson Nano
				links them to the simulation software.
			</p>
			<ul class="panels rv" style="--d:200ms" aria-hidden="true">
				{
					panels.map((p) => (
						<li class="on" data-panel>
							<b><span class="led" />PANEL {p}</b>
							<small>ESP32 · <span data-state>ONLINE</span></small>
						</li>
					))
				}
			</ul>
		</div>
		<div class="rig rv" style="--d:180ms">
			<svg viewBox="0 0 520 720" role="img" data-rig aria-label="Blueprint of a drilling rig with the drill bit descending">
				<defs>
					<pattern id="rig-hatch" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
						<path d="M0 0V10" stroke="#CFE3FF" stroke-width="1"></path>
					</pattern>
				</defs>
				{/* the strata, a little denser with depth, so the descent reads as depth */}
				<g>
					<rect x="20" y="226" width="480" height="104" fill="#CFE3FF" opacity="0.03"></rect>
					<rect x="20" y="330" width="480" height="140" fill="url(#rig-hatch)" opacity="0.06"></rect>
					<rect x="20" y="470" width="480" height="140" fill="url(#rig-hatch)" opacity="0.1"></rect>
					<rect x="20" y="610" width="480" height="90" fill="url(#rig-hatch)" opacity="0.14"></rect>
				</g>
				<g fill="none" stroke="#CFE3FF" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
					<path d="M20 210H500"></path>
					<path d="M40 210L28 226M80 210L68 226M120 210L108 226M160 210L148 226M360 210L348 226M400 210L388 226M440 210L428 226M480 210L468 226"></path>
					<path d="M200 210L248 30L296 210"></path>
					<path d="M212 165H284M224 120H272M236 75H260"></path>
					<path d="M212 165L272 120M284 165L224 120"></path>
					<rect x="236" y="18" width="24" height="12"></rect>
					<rect x="160" y="190" width="40" height="20"></rect>
					<line x1="248" y1="30" x2="248" y2="680" stroke-dasharray="6 5" data-pipe></line>
				</g>
				<g fill="none" stroke="#CFE3FF" stroke-width="1" opacity="0.35">
					<path d="M20 330H500M20 470H500M20 610H500" stroke-dasharray="2 6"></path>
				</g>
				<path d="M240 0H256L248 16Z" fill="#FF8A3D" transform="translate(0 680)" data-bit></path>
				<g stroke="#FF8A3D" stroke-width="1.2" fill="none">
					<line x1="400" y1="210" x2="400" y2="680" data-dim></line>
					<path d="M392 210H408"></path>
					<line x1="392" y1="680" x2="408" y2="680" data-dimend></line>
				</g>
				{/* the readout stays put above the ground, clear of the lines */}
				<text x="500" y="166" text-anchor="end" fill="#FF8A3D" font-family="JetBrains Mono Variable, monospace" font-size="24" font-weight="600"><tspan data-bitdepth>2400</tspan> m</text>
				<text x="500" y="188" text-anchor="end" fill="#CFE3FF" font-family="JetBrains Mono Variable, monospace" font-size="12" opacity="0.85">BIT DEPTH (SIM)</text>
				<circle cx="320" cy="96" r="12" fill="none" stroke="#CFE3FF" stroke-width="1.2"></circle>
				<text x="316" y="100" fill="#CFE3FF" font-family="JetBrains Mono Variable, monospace" font-size="11">A</text>
				<path d="M332 96H372" stroke="#CFE3FF" stroke-width="1"></path>
				<text x="378" y="100" fill="#CFE3FF" font-family="JetBrains Mono Variable, monospace" font-size="11">DERRICK</text>
				<text x="30" y="324" fill="#CFE3FF" opacity="0.85" font-family="JetBrains Mono Variable, monospace" font-size="13">STRATUM 1 · SOFT</text>
				<text x="30" y="464" fill="#CFE3FF" opacity="0.85" font-family="JetBrains Mono Variable, monospace" font-size="13">STRATUM 2 · FIRM</text>
				<text x="30" y="604" fill="#CFE3FF" opacity="0.85" font-family="JetBrains Mono Variable, monospace" font-size="13">STRATUM 3 · HARD</text>
			</svg>
		</div>
		<div class="console rv" style="--d:260ms" data-console role="group" aria-labelledby="console-t">
			<p class="console__head"><span id="console-t">Try the controls</span><span>Simulation · demo only</span></p>
			<label class="console__row">
				<span>Weight on bit</span>
				<input type="range" min="0" max="30" step="1" value="10" data-wob />
				<output data-wob-out>10 t</output>
			</label>
			<label class="console__row">
				<span>Rotary speed</span>
				<input type="range" min="0" max="180" step="5" value="60" data-rpm />
				<output data-rpm-out>60 rpm</output>
			</label>
			<div class="console__btns">
				<button type="button" class="console__pump" aria-pressed="true" data-pump>Mud pump <b data-pump-out>ON</b></button>
				<button type="button" class="console__reset" data-reset>Reset</button>
			</div>
			<dl class="console__read">
				<div><dt>Drill rate</dt><dd data-rop>0 m/h</dd></div>
				<div><dt>Bit temp</dt><dd data-temp>45 °C</dd></div>
				<div><dt>Stratum</dt><dd data-stratum>1 · soft</dd></div>
			</dl>
			<ol class="sigpath" aria-label="Signal path" data-sig>
				<li>Panel</li>
				<li>ESP32</li>
				<li>Jetson Nano</li>
				<li>Simulation</li>
			</ol>
			<p class="console__msg" role="status" data-msg>Move a control to take over from the scroll.</p>
		</div>
		<div class="titleblock rv" style="--d:300ms" aria-hidden="true">
			<span>DWG 03</span><span>DRILLING SIM</span><span>SCALE NTS</span><span>REV A</span>
		</div>
	</div>
</section>

<script>
	import "../../scripts/drill.ts";
</script>
