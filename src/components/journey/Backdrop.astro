---
import { url } from "../../lib/url";
// Fixed background layers behind the worlds, in the main site's style: the
// dark sea for the intro and the plain sections, and one layer per project.
// journey.ts fades in the one matching
// the active world (data-layer = the world's data-world); the glowing
// particles take the world's accent colour (--j-acc).
const particles = Array.from({ length: 18 }, (_, i) => ({
	x: (i * 37 + 11) % 100,
	y: (i * 53 + 7) % 100,
	s: 3 + ((i * 7) % 6),
	d: 14 + ((i * 11) % 16),
	l: -((i * 13) % 20),
}));
---

<div class="j-backdrop" aria-hidden="true">
	<div class="j-layer bg-intro on" data-layer="intro"></div>
	<div class="j-layer bg-rov" data-layer="rov">
		<img class="bg-rov__photo" src={url("/media/rov-deep.jpg")} alt="" width="640" height="360" />
		<div class="bg-rays"></div>
	</div>
	<div class="j-layer bg-school" data-layer="school"></div>
	<div class="j-layer bg-drill" data-layer="drill"></div>
	<div class="j-layer bg-iot" data-layer="iot"></div>
	<div class="j-layer bg-web" data-layer="web"><div class="bg-rays"></div></div>
	<div class="j-layer bg-plain" data-layer="plain"></div>
	{
		particles.map((p) => (
			<span
				class="j-particle"
				style={`--x:${p.x}%;--y:${p.y}%;--s:${p.s}px;--dur:${p.d}s;--delay:${p.l}s`}
			/>
		))
	}
</div>
