---
import { url } from "../../lib/url";
// The journey's first screen: the hero, in the site's base colours
// (journey.css, 00 intro). Beside the copy, the ROV's own camera as a live
// feed: a plain <video> (no three.js on the first screen) that loads only
// after the page has, and stays on its poster with reduced motion.
---

<section class="j-scene w-intro" id="top" data-world="intro" data-chapter="00 · Intro" aria-labelledby="j-hero-title">
	<div class="j-stick">
		<div class="j-copy">
			<h1 id="j-hero-title" class="rv">Hi, I'm <strong>Mohammad</strong>.</h1>
			<p class="j-hero__role rv" style="--d:80ms"><span>Embedded software engineer</span> <span>· IoT</span> <span>· Web developer</span></p>
			<p class="j-lede rv" style="--d:160ms">
				I write the code that makes hardware think, talk and dive: firmware for ESP32 and
				Raspberry Pi, the networks that carry their commands and live video, and the web apps
				and ERP systems on top.
			</p>
			<div class="j-actions">
				<a class="btn btn--primary" href={url("/Mohammad_Yarahmadi_Resume.pdf")} download>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path><path d="M12 15V3"></path></svg>
					Download CV <span class="visually-hidden">(PDF)</span>
				</a>
				<a class="btn" href="mailto:mohyar1380@gmail.com">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 6L2 7"></path></svg>
					Email me
				</a>
			</div>
		</div>
		<figure class="j-cam rv" style="--d:240ms">
			<div class="j-cam__frame">
				<video id="j-cam" poster={url("/media/rov-deep.jpg")} muted loop playsinline preload="none" width="640" height="360" aria-label="Footage from the ROV's camera: fish around an underwater structure">
					<source src={url("/media/rov-deep.webm")} type="video/webm; codecs=av01.0.04M.08" />
					<source src={url("/media/rov-deep.mp4")} type="video/mp4" />
				</video>
				<span class="j-cam__tag" aria-hidden="true"><i></i>ROV · IP camera</span>
			</div>
			<figcaption>
				Real footage from the ROV's camera. <a href="#rov">See the dive</a>
			</figcaption>
		</figure>
		{/* fades out as the visitor starts scrolling (journey.css) */}
		<a class="j-scroll" href="#rov" aria-label="Scroll to the projects">
			<span>Scroll</span>
			<i aria-hidden="true"></i>
		</a>
	</div>
</section>

<script>
	// Plays only after the page has loaded (so the clip never competes with the
	// first paint), only while on screen, and never with reduced motion.
	const cam = document.getElementById("j-cam") as HTMLVideoElement;
	const reduced = matchMedia("(prefers-reduced-motion: reduce)");
	let seen = false;
	const sync = () => (seen && !reduced.matches ? cam.play().catch(() => {}) : cam.pause());
	const start = () =>
		new IntersectionObserver(([e]) => {
			seen = e.isIntersecting;
			sync();
		}).observe(cam);
	if (document.readyState === "complete") start();
	else addEventListener("load", start, { once: true });
	reduced.addEventListener("change", sync);
</script>
