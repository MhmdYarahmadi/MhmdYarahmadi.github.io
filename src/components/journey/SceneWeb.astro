---
// A pipeline, not numbers: the work moves from first contact to live as
// the world scrolls by (journey.ts sets each row's --s stage, 0–3).
import LatencyDemo from "../islands/LatencyDemo";
// The dashboard's top half is the before/after speed demo (LatencyDemo.tsx).
const stages = ["Lead", "Scoping", "Build", "Live"];
const deals = [
	["Company website", "Dealfdi"],
	["Odoo ERP", "Operations in one place"],
	["Odoo CRM", "Customers and sales"],
];
---

<section class="j-scene w-web" id="web" data-world="web" data-chapter={"05 · Websites & Enterprise · Dashboard"} aria-label="Websites and Enterprise">
	<div class="j-stick">
		<div class="j-copy">
			<p class="j-tag rv">05 · Websites &amp; Enterprise</p>
			<h2 class="rv" style="--d:60ms">Websites and ERP that businesses run on</h2>
			<p class="j-lede rv" style="--d:120ms">
				At Zilber in Tehran I deploy Odoo ERP for business clients, write custom Odoo modules
				that connect IoT devices to it, and build company websites, currently Dealfdi. I cut a
				dashboard's latency from 2 s to 150 ms, over 13× faster. Before that I handled client
				discovery and sales for a web team, so I know the client's side of the table too.
			</p>
			<ul class="pills rv" style="--d:180ms">
				<li>Odoo ERP · CRM</li>
				<li>Custom modules</li>
				<li>IoT ↔ ERP</li>
				<li>Company sites</li>
			</ul>
		</div>
		<div class="dash rv" style="--d:160ms">
			<LatencyDemo client:visible />
			<div class="pipe" aria-hidden="true">
				<div class="pipe__cols">{stages.map((st) => <span>{st}</span>)}</div>
				<ul class="pipe__rows">
					{
						deals.map(([title, sub], i) => (
							<li class="deal live" data-deal={i} style="--s:3">
								<p>
									<strong>{title}</strong>
									<span>{sub}</span>
									<em data-stage>Live</em>
								</p>
								<div class="deal__bar"><i></i></div>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>
