---
import { url } from "../lib/url";
import "../styles/global.css";
import "../styles/animations.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title: string;
	description?: string;
	/** Lets a page restyle the body, e.g. a page with its own background. */
	bodyClass?: string;
	/** Leave out the site header (the /journey/ page has none). */
	nav?: boolean;
}

const {
	title,
	description = "Portfolio of hardware, embedded, and software projects.",
	bodyClass,
	nav = true,
} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{/* Scroll-reveal hides content until observed, so it must only apply
		    when JS is actually running — otherwise a failed script leaves the
		    whole page blank. Inline and in <head> so it lands before paint. */}
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
		<slot name="head" />
	</head>
	<body class={bodyClass}>
		{nav && <Nav />}
		<main>
			<slot />
		</main>
		<Footer />
		<script>
			import "../scripts/reveal.ts";
		</script>
	</body>
</html>
